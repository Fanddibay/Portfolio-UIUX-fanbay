# Copy this file to `.env.local` and fill in real values.

# --- Contact form (Google Sheets via Apps Script) ---
# The deployed Apps Script Web App URL (ends with /exec). Each submission is
# inserted as a new row in the "Contact Fandi" Google Sheet.
# Set CONTACT_ENDPOINT in Cloudflare Pages Production as well as .env.local.
# Script + setup steps: scripts/contact-apps-script.gs.
CONTACT_ENDPOINT=

# --- Google Analytics 4 ---
# Measurement ID from GA4 → Admin → Data streams → Web (format G-XXXXXXXXXX).
# Loaded only in production builds. Set the same var in Cloudflare Pages
# (Settings → Environment variables) and redeploy.
NEXT_PUBLIC_GA_ID=

# --- Google Search Console (optional) ---
# The content value of the HTML-tag verification method, e.g. "abc123…".
NEXT_PUBLIC_GSC_VERIFICATION=
